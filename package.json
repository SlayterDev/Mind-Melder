{
  "name": "mind-melder",
  "version": "1.0.1",
  "description": "Quick Capture & AI Organizer - Self-hosted productivity tool",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --filter \"./apps/api\" dev & pnpm --filter \"./apps/web\" dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "pnpm --filter database generate",
    "db:migrate": "pnpm --filter database migrate",
    "db:push": "pnpm --filter database push",
    "db:studio": "pnpm --filter database studio",
    "db:test": "pnpm --filter database test",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart",
    "docker:clean": "docker compose down -v",
    "desktop:dev": "pnpm --filter \"./apps/api\" dev & pnpm --filter \"./apps/web\" electron:dev",
    "desktop:build": "pnpm --filter \"./apps/web\" electron:build",
    "desktop:build:mac": "pnpm --filter \"./apps/web\" electron:build:mac",
    "desktop:build:win": "pnpm --filter \"./apps/web\" electron:build:win",
    "desktop:build:linux": "pnpm --filter \"./apps/web\" electron:build:linux"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "types": "workspace:*"
  }
}
